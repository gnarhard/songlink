includes:
    - phpstan-baseline.neon

parameters:
    level: 5
    paths:
        - src
        - config
        - database
    tmpDir: build/phpstan
    checkOctaneCompatibility: true
    checkModelProperties: true
    configDirectories:
        - config
    ignoreErrors:
        # errors.404 and pages.listen are views of the host application, invisible to the package.
        -
            identifier: argument.type
            path: src/Http/Controllers/SongLinkController.php
            count: 2
